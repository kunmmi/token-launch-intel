# Local defaults match infra/docker-compose.yml — override for other environments.
DATABASE_URL=postgres://tli:tli_dev_password@localhost:5432/token_launch_intel
REDIS_URL=redis://localhost:6379

# Pump adapter's default (public mainnet RPC) blocks getTokenLargestAccounts
# outright — holder-concentration tracking (scripts/snapshot-pump-holders.mjs)
# needs a provider that allows it. Alchemy's free tier does (verified live).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# indexer service only
VENUE=pump
ADAPTER_MODE=synthetic
SYNTHETIC_LAUNCH_INTERVAL_MS=3000
