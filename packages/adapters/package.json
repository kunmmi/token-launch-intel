{
  "name": "@tli/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:pump-sdk-bundle:src && tsc -p tsconfig.json && npm run build:pump-sdk-bundle:copy",
    "build:pump-sdk-bundle:src": "esbuild src/pump/pump-sdk-entry.mjs --bundle --platform=node --format=cjs --outfile=src/pump/pump-sdk-bundle.cjs --external:@solana/web3.js --external:@coral-xyz/anchor",
    "build:pump-sdk-bundle:copy": "node -e \"require('fs').copyFileSync('src/pump/pump-sdk-bundle.cjs','dist/pump/pump-sdk-bundle.cjs')\"",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pump-fun/pump-sdk": "^2.0.0",
    "@solana/web3.js": "^1.99.0",
    "@tli/core": "*",
    "bn.js": "^5.2.2",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
